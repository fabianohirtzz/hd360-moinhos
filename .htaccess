# HD360 Moinhos, site estático (ErêHost / LiteSpeed)

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # sempre https://hd360.com.br (sem www)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://hd360.com.br%{REQUEST_URI} [L,R=301]

  # /link sem barra no fim também abre a página do link da bio
  RewriteRule ^link$ /link/ [L,R=301]

  # endereços das páginas no WordPress antigo -> páginas novas
  RewriteRule ^(atendimento|equipe|unidades|ouvidoria|blog|faq|trabalhe-conosco|politica-de-privacidade|politica-de-cookies|termos-de-uso)/?$ /$1.html [L,R=301]
  RewriteRule ^(contato|fale-conosco|sobre|quem-somos)/?$ / [L,R=301]
  RewriteRule ^unidade/?$ /unidades.html [L,R=301]

  # restos do WordPress que o Google ainda conhece: sitemaps, feeds, categorias, tags, autores, paginação
  RewriteRule ^(wp-sitemap.*|sitemap_index|post-sitemap|page-sitemap|category-sitemap)\.xml$ /sitemap.xml [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ /blog.html [L,R=301]
  RewriteRule ^(.+)/feed/?$ /$1/ [L,R=301]
  RewriteRule ^(category|tag|author)/ /blog-todos.html [L,R=301]
  RewriteRule ^page/[0-9]+/?$ /blog-todos.html [L,R=301]

  # /index.html vira só /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml

# cache: páginas sempre frescas, mídia por mais tempo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php84” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
